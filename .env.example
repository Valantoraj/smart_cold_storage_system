# InfluxDB Configuration
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpass123
INFLUXDB_ORG=smart_cooling
INFLUXDB_BUCKET=cold_storage
INFLUXDB_TOKEN=smart-cooling-super-secret-token
INFLUXDB_RETENTION=90d

# MongoDB Configuration (for Ditto)
MONGO_USERNAME=ditto
MONGO_PASSWORD=ditto

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# MQTT Configuration
MQTT_USERNAME=
MQTT_PASSWORD=

# API Configuration
API_PORT=3001
NODE_ENV=production

# Alert Configuration
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Thresholds
TEMP_THRESHOLD_HIGH=8.0
TEMP_THRESHOLD_LOW=2.0
HUMIDITY_THRESHOLD_HIGH=80
HUMIDITY_THRESHOLD_LOW=50
ENERGY_THRESHOLD_WARNING=3.0
ENERGY_THRESHOLD_CRITICAL=4.0
