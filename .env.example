# =============================================================================
# Smart Cold Storage Digital Twin — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored and MUST NEVER be committed to GitHub.
#
# Quick setup:
#   Single machine : set NODE_ROLE=single  (or leave blank)
#   Laptop 1       : set NODE_ROLE=alpha
#   Laptop 2       : set NODE_ROLE=beta
#   Laptop 3       : set NODE_ROLE=gamma
#
# Then run: .\setup.ps1 -Role <role>
# =============================================================================

# ─── Node Role ────────────────────────────────────────────────────────────────
# Controls which Docker Compose profile starts on this machine
# Values: single | alpha | beta | gamma
NODE_ROLE=single

# Units this machine simulates (comma-separated)
UNIT_IDS=CS-01,CS-02,CS-03

# Warehouse identifier for this machine
WAREHOUSE_ID=local

# ─── InfluxDB ─────────────────────────────────────────────────────────────────
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpass123
INFLUXDB_ORG=smart_cooling
INFLUXDB_BUCKET=cold_storage
INFLUXDB_TOKEN=smart-cooling-super-secret-token
# 90d for single machine, 7d for edge nodes (alpha/beta)
INFLUXDB_RETENTION=90d

# Central InfluxDB URL (GCP VM in distributed mode)
CENTRAL_INFLUXDB_URL=http://influxdb:8086
CENTRAL_INFLUXDB_TOKEN=smart-cooling-super-secret-token

# ─── MongoDB (Eclipse Ditto backend) ──────────────────────────────────────────
MONGO_USERNAME=ditto
MONGO_PASSWORD=ditto

# ─── Eclipse Ditto ────────────────────────────────────────────────────────────
# Single machine: points to local ditto-gateway
# Distributed: points to GCP VM
DITTO_URL=http://ditto-gateway:8080
DITTO_WS_URL=ws://ditto-gateway:8080/ws/2

# ─── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ─── MQTT ─────────────────────────────────────────────────────────────────────
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── REST API ─────────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=production

# ─── Email Alerts ─────────────────────────────────────────────────────────────
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=465
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_APP_PASSWORD=

# ─── Detection Thresholds ─────────────────────────────────────────────────────
TEMP_THRESHOLD_HIGH=8.0
TEMP_THRESHOLD_LOW=2.0
HUMIDITY_THRESHOLD_HIGH=80
HUMIDITY_THRESHOLD_LOW=50
ENERGY_THRESHOLD_WARNING=3.0
ENERGY_THRESHOLD_CRITICAL=4.0

# ─── Edge Intelligence ────────────────────────────────────────────────────────
# Enable adaptive thresholds (true for alpha/beta, false for single)
ADAPTIVE_THRESHOLDS=false
# Enable ioFog message bus integration (true for alpha/beta, false for single)
IOFOG_BUS_ENABLED=false

# ─── ioFog Configuration ──────────────────────────────────────────────────────
# Set this after running gcp/setup.sh
# Get IP from: gcloud compute instances describe iofog-controller \
#              --zone=asia-south1-a --format='get(networkInterfaces[0].accessConfigs[0].natIP)'
IOFOG_CONTROLLER_IP=
IOFOG_CONTROLLER_PORT=51121
IOFOG_AGENT_NAME=${NODE_ROLE}-agent

# ─── GCP Configuration ────────────────────────────────────────────────────────
# IMPORTANT: Never commit these values to GitHub
# Get project ID from: https://console.cloud.google.com
GCP_PROJECT_ID=
GCP_REGION=asia-south1
GCP_BIGQUERY_DATASET=cold_storage_lake

# GCP Pub/Sub topics
GCP_PUBSUB_TOPIC_SENSORS=smart-cooling-sensor-events
GCP_PUBSUB_TOPIC_ANOMALIES=smart-cooling-anomaly-alerts
GCP_PUBSUB_TOPIC_TRIGGERS=smart-cooling-agent-triggers
GCP_PUBSUB_TOPIC_NOTIFICATIONS=smart-cooling-notifications

# GCP Storage buckets (appended with project ID by setup.sh)
GCP_STORAGE_BUCKET_REPORTS=smart-cooling-reports
GCP_STORAGE_BUCKET_ARTIFACTS=smart-cooling-artifacts

# Path to GCP service account key (generated by gcp/setup.sh)
# This file is gitignored — never commit it
GCP_SERVICE_ACCOUNT_KEY_FILE=gcp/service-account.json

# Vertex AI Agent Engine resource ID (set after Phase 6 deployment)
GCP_AGENT_ENGINE_ID=
GCP_AGENT_API_URL=

# ─── Laptop IPs (for iofogctl agents.yaml) ────────────────────────────────────
# Set the LAN/public IP of each laptop
# Used by iofogctl to register agents with the Controller
LAPTOP1_IP=
LAPTOP1_SSH_USER=
LAPTOP2_IP=
LAPTOP2_SSH_USER=
LAPTOP3_IP=
LAPTOP3_SSH_USER=
