# ── Machine IPs (fill after Phase 1) ────────────────────────────────────────
# LAN IPs if all on same network, OR Tailscale 100.x.y.z IPs if on different networks
L1_IP=192.168.x.x           # Edge laptop
L2_IP=192.168.x.x           # Fog laptop
L3_IP=192.168.x.x           # This laptop (Controller + Ditto)
LINUX_USER=ubuntu_user_name  # same username on all three WSL installs
SSH_PORT=2222

# ── GCP ─────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=project-f47e3be0-07f0-4225-b8e
GCP_REGION=us-central1
BQ_LOCATION=US
BQ_DATASET=coldstorage
AR_REPO=coldtwin
IMAGE_PREFIX=us-central1-docker.pkg.dev/\/coldtwin
IMAGE_TAG=1.0.0

# ── Services ────────────────────────────────────────────────────────────────
INFLUX_ORG=coldchain
INFLUX_BUCKET=telemetry
INFLUX_TOKEN=change-me-long-random-token-here
GRAFANA_ADMIN_PASSWORD=change-me
DITTO_USER=ditto
DITTO_PASSWORD=ditto
GEMINI_MODEL=               # filled in Phase 7
